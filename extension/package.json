{
  "name": "soundcloud-ai-lyrics-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: lyrics for SoundCloud tracks - ready-made lyrics or speech recognition, karaoke and translation",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
